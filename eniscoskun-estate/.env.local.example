# Google Yorumları entegrasyonu (opsiyonel — yoksa sitedeki yedek yorumlar gösterilir)
# 1) https://console.cloud.google.com → yeni proje → "Places API (New)" etkinleştir
# 2) API anahtarı oluştur ve aşağıya yapıştır
# 3) Bu dosyayı ".env.local" adıyla kopyala ve dev sunucusunu yeniden başlat
GOOGLE_MAPS_API_KEY=

# Opsiyonel: İşletmenizin Google Place ID'si.
# Boş bırakılırsa "UYG GOLD REAL ESTATE İncek Gölbaşı Ankara" aramasıyla otomatik bulunur.
# Place ID bulucu: https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACE_ID=
